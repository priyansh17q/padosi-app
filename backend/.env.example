# Web Push (Notifications — sabke phone pe). Apni khud ki keys banao (private key kabhi git me mat daalo):
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Razorpay (UPI + Card escrow payments) — dashboard.razorpay.com se TEST keys lo (KYC nahi chahiye test mode ke liye)
# Khaali chhod do to payment step automatically skip ho jayega (dev/demo mode)
