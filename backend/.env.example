# Supabase (Settings → API se copy karo)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role_key_yahan

# OTP mail — Render FREE tier SMTP (Gmail App Password wala tareeka) BLOCK karta hai, isliye HTTPS wala use karo:
# Google Apps Script web app (DEPLOY.md "Step 2" dekho). Dono bharne par yahi use hota hai.
MAIL_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxx/exec
MAIL_WEBHOOK_SECRET=koi-lamba-random-secret-jo-script-me-bhi-wahi-hai

# (Optional) Gmail SMTP — sirf local ya paid hosting pe chalta hai, free Render pe nahi (myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sirf LOCAL ke liye: true karne par OTP console/response me aa jata hai (mail ke bina test). Production me kabhi true mat karo.
ALLOW_DEV_OTP=false

# CORS — frontend URLs jo allowed hain (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://aapka-app.netlify.app

# Web Push (Notifications — sabke phone pe). Apni khud ki keys banao (private key kabhi git me mat daalo):
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Razorpay (UPI + Card escrow payments) — dashboard.razorpay.com se TEST keys lo (KYC nahi chahiye test mode ke liye)
# Khaali chhod do to payment step automatically skip ho jayega (dev/demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server port
PORT=3001
